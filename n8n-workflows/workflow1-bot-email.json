{
  "name": "EduSchedule — 1. Bot Email + WhatsApp",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "weeks", "weeksInterval": 1, "triggerAtDay": [1], "triggerAtHour": 7, "triggerAtMinute": 0 }]
        }
      },
      "id": "cron-lundi",
      "name": "Cron — Lundi 7h00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [180, 260]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "email-trigger",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook-dashboard",
      "name": "Webhook — Dashboard",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [180, 460]
    },
    {
      "parameters": {
        "url": "https://backend-springboot-planning.onrender.com/api/webhook/preparer-envoi",
        "method": "POST",
        "sendBody": true,
        "contentType": "json",
        "body": "={}",
        "options": { "timeout": 90000 }
      },
      "id": "preparer-envoi",
      "name": "Préparer envoi (Render)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [420, 360],
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 10000
    },
    {
      "parameters": {
        "fieldToSplitOut": "professeurs",
        "options": {}
      },
      "id": "split-profs",
      "name": "Split par professeur",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [640, 360]
    },
    {
      "parameters": {
        "url": "https://api.resend.com/emails",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer YOUR_RESEND_API_KEY" },
            { "name": "Content-Type",  "value": "application/json" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={{ JSON.stringify({ from: 'EduSchedule <onboarding@resend.dev>', to: [$('Split par professeur').item.json.email], subject: '📅 EduSchedule — Vos disponibilités — semaine prochaine', html: \"<!DOCTYPE html><html><head><meta charset='utf-8'></head><body style='font-family:Arial,sans-serif;background:#F1F5F9;padding:24px;'><div style='max-width:520px;margin:0 auto;'><div style='background:#1E1B4B;padding:20px;border-radius:12px 12px 0 0;text-align:center;'><h1 style='color:white;margin:0;font-size:20px;'>📅 EduSchedule</h1><p style='color:#A5B4FC;margin:4px 0 0;font-size:12px;'>Institut Supérieur du Digital</p></div><div style='background:white;padding:24px;border-radius:0 0 12px 12px;'><p style='color:#1F2937;'>Bonjour <strong>\" + $('Split par professeur').item.json.nom + \"</strong> 👋</p><p style='color:#4B5563;'>Merci de saisir vos <strong>disponibilités pour la semaine prochaine</strong>.</p><p style='color:#4B5563;'>Modules : <strong>\" + ($('Split par professeur').item.json.modules ? $('Split par professeur').item.json.modules.join(', ') : $('Split par professeur').item.json.matiere) + \"</strong></p><div style='text-align:center;margin:28px 0;'><a href='\" + $('Split par professeur').item.json.lienReponse + \"' style='background:#4338CA;color:white;padding:14px 32px;border-radius:10px;text-decoration:none;font-weight:700;font-size:15px;'>✏️ Saisir mes disponibilités</a></div><p style='color:#9CA3AF;font-size:11px;text-align:center;'>Lien personnel valide 7 jours — ne pas partager.</p><p style='color:#9CA3AF;font-size:10px;text-align:center;margin-top:20px;'>Institut Supérieur du Digital — EduSchedule</p></div></div></body></html>\" }) }}",
        "options": { "timeout": 30000 }
      },
      "id": "envoyer-email",
      "name": "Envoyer Email (Resend)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [860, 280],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "operation": "sendMessage",
        "from": "whatsapp:+14155238886",
        "to": "=whatsapp:+{{ $('Split par professeur').item.json.telephone ? $('Split par professeur').item.json.telephone.replace(/[^0-9]/g, '') : '' }}",
        "message": "=📅 *EduSchedule — ISD*\n\nBonjour *{{ $('Split par professeur').item.json.nom }}* 👋\n\nVeuillez saisir vos disponibilités pour la semaine prochaine.\n\n📚 *Modules :* {{ $('Split par professeur').item.json.modules ? $('Split par professeur').item.json.modules.join(', ') : $('Split par professeur').item.json.matiere }}\n\n🔗 {{ $('Split par professeur').item.json.lienReponse }}\n\n_Lien valide 7 jours — Institut Supérieur du Digital_"
      },
      "id": "twilio-whatsapp",
      "name": "WhatsApp Twilio",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [1080, 280],
      "retryOnFail": false,
      "onError": "continueRegularOutput",
      "credentials": { "twilioApi": { "id": "twilio-cred", "name": "Twilio Sandbox" } }
    },
    {
      "parameters": {
        "url": "=https://backend-springboot-planning.onrender.com/api/professeurs/{{ $('Split par professeur').item.json.id }}/whatsapp-statut",
        "method": "PATCH",
        "sendBody": true,
        "contentType": "json",
        "body": "={\"statut\": \"ENVOYE\"}",
        "options": { "timeout": 30000 }
      },
      "id": "marquer-envoye",
      "name": "Marquer ENVOYE (Render)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1300, 280],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "Cron — Lundi 7h00":       { "main": [[{ "node": "Préparer envoi (Render)", "type": "main", "index": 0 }]] },
    "Webhook — Dashboard":     { "main": [[{ "node": "Préparer envoi (Render)", "type": "main", "index": 0 }]] },
    "Préparer envoi (Render)": { "main": [[{ "node": "Split par professeur", "type": "main", "index": 0 }]] },
    "Split par professeur":    { "main": [[{ "node": "Envoyer Email (Resend)", "type": "main", "index": 0 }]] },
    "Envoyer Email (Resend)":  { "main": [[{ "node": "WhatsApp Twilio", "type": "main", "index": 0 }]] },
    "WhatsApp Twilio":         { "main": [[{ "node": "Marquer ENVOYE (Render)", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1", "saveManualExecutions": true },
  "tags": [{ "name": "eduschedule" }, { "name": "email" }, { "name": "whatsapp" }, { "name": "resend" }]
}
