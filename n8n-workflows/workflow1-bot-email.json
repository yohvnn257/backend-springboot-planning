{
  "name": "EduSchedule — 1. Bot Email + WhatsApp",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "weeks", "weeksInterval": 1, "triggerAtDay": [1], "triggerAtHour": 7, "triggerAtMinute": 0 }]
        }
      },
      "id": "cron-lundi",
      "name": "Cron — Lundi 7h00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [180, 260]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "email-trigger",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook-dashboard",
      "name": "Webhook — Dashboard",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [180, 460]
    },
    {
      "parameters": {
        "url": "https://backend-springboot-planning.onrender.com/api/webhook/preparer-envoi",
        "method": "POST",
        "sendBody": true,
        "contentType": "json",
        "body": "={}",
        "options": { "timeout": 90000 }
      },
      "id": "preparer-envoi",
      "name": "Préparer envoi (Render)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [420, 360],
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 10000
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst profs = data.professeurs || data.body?.professeurs || [];\nif (!profs.length) throw new Error('Aucun professeur — vérifiez que Render est actif et que des profs existent');\nconsole.log(`${profs.length} prof(s) avec tokens générés via /preparer-envoi`);\nreturn profs.map(p => ({ json: p }));"
      },
      "id": "extraire-profs",
      "name": "Extraire professeurs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [640, 360]
    },
    {
      "parameters": {
        "url": "https://api.mailjet.com/v3.1/send",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Basic YOUR_BASE64_API_KEY_SECRET" },
            { "name": "Content-Type",  "value": "application/json" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={{ JSON.stringify({ Messages: [{ From: { Email: 'yohanntoure40@gmail.com', Name: 'EduSchedule ISD' }, To: [{ Email: $('Extraire professeurs').item.json.email, Name: $('Extraire professeurs').item.json.nom }], Subject: 'EduSchedule — Vos disponibilités — semaine prochaine', HTMLPart: \"<div style='font-family:Arial,sans-serif;max-width:600px;margin:0 auto;'><div style='background:linear-gradient(135deg,#1E1B4B,#4338CA);padding:24px;border-radius:12px 12px 0 0;'><h1 style='color:white;margin:0;font-size:22px;'>EduSchedule</h1><p style='color:#A5B4FC;margin:4px 0 0;font-size:14px;'>Institut Superieur du Digital</p></div><div style='background:white;padding:28px;border:1px solid #E5E7EB;border-radius:0 0 12px 12px;'><p style='font-size:17px;color:#1F2937;'>Bonjour <strong>\" + $('Extraire professeurs').item.json.nom + \"</strong></p><p style='color:#4B5563;'>Nous preparons l'emploi du temps de la semaine prochaine.</p><div style='background:#F8FAFC;border-left:4px solid #4338CA;padding:12px 16px;margin:16px 0;'><p style='margin:0;'>Modules : <strong>\" + ($('Extraire professeurs').item.json.modules ? $('Extraire professeurs').item.json.modules.join(', ') : $('Extraire professeurs').item.json.matiere) + \"</strong></p></div><p style='color:#4B5563;'>Cliquez sur le bouton ci-dessous pour indiquer vos disponibilites :</p><div style='text-align:center;margin:28px 0;'><a href='\" + $('Extraire professeurs').item.json.lienReponse + \"' style='background:#4338CA;color:white;padding:16px 36px;border-radius:10px;text-decoration:none;font-size:16px;display:inline-block;'>Indiquer mes disponibilites</a></div><p style='color:#9CA3AF;font-size:12px;'>Lien personnel valide 7 jours, ne pas partager.</p><hr style='border:none;border-top:1px solid #E5E7EB;margin:20px 0;'><p style='color:#9CA3AF;font-size:11px;margin:0;'>Institut Superieur du Digital — EduSchedule</p></div></div>\" }] }) }}",
        "options": { "timeout": 30000 }
      },
      "id": "envoyer-email",
      "name": "Envoyer Email (Mailjet)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [860, 280],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "operation": "sendMessage",
        "from": "whatsapp:+14155238886",
        "to": "=whatsapp:+{{ $('Extraire professeurs').item.json.telephone ? $('Extraire professeurs').item.json.telephone.replace(/[^0-9]/g, '') : '' }}",
        "message": "=📅 *EduSchedule — ISD*\n\nBonjour *{{ $('Extraire professeurs').item.json.nom }}* 👋\n\nVeuillez saisir vos disponibilités pour la semaine prochaine.\n\n📚 *Modules :* {{ $('Extraire professeurs').item.json.modules ? $('Extraire professeurs').item.json.modules.join(', ') : $('Extraire professeurs').item.json.matiere }}\n\n🔗 {{ $('Extraire professeurs').item.json.lienReponse }}\n\n_Lien valide 7 jours — Institut Supérieur du Digital_"
      },
      "id": "twilio-whatsapp",
      "name": "WhatsApp Twilio",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [1080, 280],
      "retryOnFail": false,
      "onError": "continueRegularOutput",
      "credentials": { "twilioApi": { "id": "twilio-cred", "name": "Twilio Sandbox" } }
    },
    {
      "parameters": {
        "url": "=https://backend-springboot-planning.onrender.com/api/professeurs/{{ $('Extraire professeurs').item.json.id }}/whatsapp-statut",
        "method": "PATCH",
        "sendBody": true,
        "contentType": "json",
        "body": "={\"statut\": \"ENVOYE\"}",
        "options": { "timeout": 30000 }
      },
      "id": "marquer-envoye",
      "name": "Marquer ENVOYE (Render)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1300, 280],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "Cron — Lundi 7h00":       { "main": [[{ "node": "Préparer envoi (Render)", "type": "main", "index": 0 }]] },
    "Webhook — Dashboard":     { "main": [[{ "node": "Préparer envoi (Render)", "type": "main", "index": 0 }]] },
    "Préparer envoi (Render)": { "main": [[{ "node": "Extraire professeurs", "type": "main", "index": 0 }]] },
    "Extraire professeurs":    { "main": [[{ "node": "Envoyer Email (Mailjet)", "type": "main", "index": 0 }]] },
    "Envoyer Email (Mailjet)": { "main": [[{ "node": "WhatsApp Twilio", "type": "main", "index": 0 }]] },
    "WhatsApp Twilio":         { "main": [[{ "node": "Marquer ENVOYE (Render)", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1", "saveManualExecutions": true },
  "tags": [{ "name": "eduschedule" }, { "name": "email" }, { "name": "whatsapp" }, { "name": "mailjet" }]
}
